# ==============================================================================
# Zero-Local-Compute Autonomous Video Production Studio Environment Configuration
# Drop your free API keys below. All heavy rendering and generation run in the cloud.
# ==============================================================================

# [FREE] Zhipu AI CogVideoX-Flash
# 100% Free video generation model tier (0 cost, no subscription required).
# Get your key at: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=cogvideox-flash

# [FREE CREDITS] SiliconFlow Wan 2.1 / Wan 2.2
# Free registration credits for Wan 2.1 / Wan 2.2 high-quality diffusion video.
# Get your key at: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_MODEL=Wan-AI/Wan2.1-T2V-14B

# [FREE TIER] Google Gemini API
# Free tier multimodal scripting, visual direction, and Veo integrations.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [FREE CLOUD GPU] Remote ComfyUI / Wan2GP Cloudflare Tunnel
# Remote tunnel URL when running Wan2GP or ComfyUI on free Kaggle Dual-T4 / Colab.
# Example: https://random-name.trycloudflare.com
COMFYUI_REMOTE_URL=https://your-cloudflare-tunnel-url.trycloudflare.com

# [FREE] Pexels Stock Video API
# Free HD/4K stock video footage and B-roll queries.
# Get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# [GITHUB] GitHub CLI / Matrix Renderer Automation
# Typically authenticated via `gh auth login`, or set here for CI/CD runners.
GITHUB_TOKEN=your_github_token_here
